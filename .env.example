# ─────────────────────────────────────────────────────────────────────────────
# Vele environment. Copy to `.env` (or run `pnpm setup`, which generates the
# secrets for you). Never commit `.env`.
# Everything marked (optional) can be left blank: the feature degrades and the
# UI says so, it never pretends to work.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vele

# PostgreSQL. `pnpm db:start` runs a project-local cluster matching these URLs.
DATABASE_URL=postgresql://vele@127.0.0.1:5434/vele
TEST_DATABASE_URL=postgresql://vele@127.0.0.1:5434/vele_test

# Secrets (generate with `pnpm setup`, or `openssl rand -base64 32`)
AUTH_SECRET=
# Protects /api/cron/* (periodic maintenance, email retries, reminders)
CRON_SECRET=

# Comma-separated emails that receive the admin role when they sign up
ADMIN_EMAILS=


# ── AI: Google Gemini (optional; without a key Vele runs in offline mode) ────
# Get a key at https://aistudio.google.com/apikey
# One or more keys, comma separated. Vele uses the next key for each request.
GEMINI_API_KEYS=
# Most capable Gemini for agentic tool use. gemini-3.1-pro-preview needs a key with billing enabled.
GEMINI_MODEL=gemini-3.8-flash

# ── Email (optional; without a key emails are logged to the dev outbox) ──────
# brevo | resend | console. EMAIL_FROM must be a sender verified with the provider.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Vele <onboarding@resend.dev>"

# ── Messaging (optional) ─────────────────────────────────────────────────────
# Telegram: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta for Developers → WhatsApp → API Setup).
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
